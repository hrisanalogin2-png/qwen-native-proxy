{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen 3.7 Max (Local)",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "any"
      },
      "models": {
        "qwen3.7-max": {
          "name": "Qwen 3.7 Max",
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen 3.6 Plus",
          "reasoning": true
        },
        "qwen3.5-plus": {
          "name": "Qwen 3.5 Plus",
          "reasoning": true
        },
        "qwen3-max": {
          "name": "Qwen 3 Max",
          "reasoning": true
        },
        "qwen3-coder-plus": {
          "name": "Qwen 3 Coder Plus",
          "reasoning": true
        }
      }
    },
    "deepseek-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek V4 Flash (Local)",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "any"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "qwen-local/qwen3.7-max"
}
